const QOL_MENU_OPTION_REPEL = 1
const QOL_MENU_OPTION_POKEVIAL = 2
const QOL_MENU_OPTION_SIZE_UP = 3
const QOL_MENU_OPTION_SIZE_DOWN = 4
const QOL_MENU_OPTION_DOSE_UP = 5
const QOL_MENU_OPTION_DOSE_DOWN = 6
const QOL_MENU_OPTION_REFILL = 7
const QOL_MENU_OPTION_EXP_ALL = 8
const QOL_MENU_OPTION_WAIT = 9
const QOL_MENU_OPTION_ABILICHANGE = 10
const QOL_MENU_OPTION_NATURE_CHANGE = 11

const TIME_ITEM_MORNING = 10;
const TIME_ITEM_DAY = 20;
const TIME_ITEM_EVENING = 30;
const TIME_ITEM_NIGHT = 40;

script EventScript_QolMenu {
    
    lock

    dynmultipush("Wait until...", QOL_MENU_OPTION_WAIT)
    
    if(checkitem(ITEM_POKEVIAL)){
        pokevialgetsize()
        buffernumberstring(STR_VAR_2, VAR_0x8006)
        pokevialgetdose()
        buffernumberstring(STR_VAR_1, VAR_0x8006)
        if(var(VAR_0x8006) == 0){
            dynmultipush("Pokévial: {CLEAR_TO 60}0/{STR_VAR_2}", QOL_MENU_OPTION_POKEVIAL)
        } else {
            pokevialisfull()
            if(var(VAR_RESULT) == 1){
                dynmultipush("Pokévial: {CLEAR_TO 60}{COLOR BLUE}{SHADOW LIGHT_BLUE}{STR_VAR_1}/{STR_VAR_2}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}", QOL_MENU_OPTION_POKEVIAL)
            } else {
                dynmultipush("Pokévial: {CLEAR_TO 60}{COLOR GREEN}{SHADOW LIGHT_GREEN}{STR_VAR_1}/{STR_VAR_2}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}", QOL_MENU_OPTION_POKEVIAL)
            }
        }
        
        // dynmultipush("Size up", QOL_MENU_OPTION_SIZE_UP)
        // dynmultipush("Size down", QOL_MENU_OPTION_SIZE_DOWN)
        // dynmultipush("Dose up", QOL_MENU_OPTION_DOSE_UP)
        // dynmultipush("Dose down", QOL_MENU_OPTION_DOSE_DOWN)
        // dynmultipush("Refill", QOL_MENU_OPTION_REFILL)
    }

    if(flag(FLAG_SID_REPEL)){
        dynmultipush("Repel: {CLEAR_TO 60}{COLOR GREEN}{SHADOW LIGHT_GREEN}ON", QOL_MENU_OPTION_REPEL)
    } else {
        dynmultipush("Repel: {CLEAR_TO 60}off", QOL_MENU_OPTION_REPEL)
    }

    if(checkitem(ITEM_EXP_ALL)){
        if(flag(FLAG_I_EXP_SHARE)){
            dynmultipush("Exp-All: {CLEAR_TO 60}{COLOR GREEN}{SHADOW LIGHT_GREEN}ON", QOL_MENU_OPTION_EXP_ALL)
        } else {
            dynmultipush("Exp-All: {CLEAR_TO 60}off", QOL_MENU_OPTION_EXP_ALL)
        }
    }

    dynmultipush("Change ability", QOL_MENU_OPTION_ABILICHANGE)
    dynmultipush("Change nature", QOL_MENU_OPTION_NATURE_CHANGE)

    dynmultistack(0, 0, FALSE, 9, FALSE, QOL_MENU_OPTION_WAIT, DYN_MULTICHOICE_CB_NONE)

    switch(var(VAR_RESULT)){
        case QOL_MENU_OPTION_REPEL:
            if(flag(FLAG_SID_REPEL)){
                clearflag(FLAG_SID_REPEL)
                msgbox(format("Repel turned off. Catch 'em all!"))
            } else {
                setflag(FLAG_SID_REPEL)
                msgbox(format("Repel turned {COLOR GREEN}{SHADOW LIGHT_GREEN}ON{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}. You're scaring wild Pokémon away!"))
            }
        case QOL_MENU_OPTION_POKEVIAL:
            pokevialtryuse()
        case QOL_MENU_OPTION_SIZE_UP:
            pokevialincreasesize()
            pokevialrefill()
        case QOL_MENU_OPTION_SIZE_DOWN:
            pokevialdecreasesize()
        case QOL_MENU_OPTION_DOSE_UP:
            pokevialadddose()
        case QOL_MENU_OPTION_DOSE_DOWN:
            pokevialremovedose()
        case QOL_MENU_OPTION_REFILL:
            pokevialrefill()
        case QOL_MENU_OPTION_EXP_ALL:
            if(flag(FLAG_I_EXP_SHARE)){
                clearflag(FLAG_I_EXP_SHARE)
                msgbox(format("Exp-all turned off. That's the sigma grindset way."))
            } else {
                setflag(FLAG_I_EXP_SHARE)
                msgbox(format("Exp-all turned {COLOR GREEN}{SHADOW LIGHT_GREEN}ON{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}. Easy level farming for your whole party!"))
            }
        case QOL_MENU_OPTION_WAIT:
            call(EventScript_QolMenu_Wait)
        case QOL_MENU_OPTION_ABILICHANGE:
            call(EventScript_QolMenu_PickAbiliChangeMon)
        case QOL_MENU_OPTION_NATURE_CHANGE:
            call(EventScript_QolMenu_PickNatureChangeMon)
        default:
    }
    waitmessage
    release
    end
}

text EventScript_QolMenu_WaitText {
    "It's {COLOR BLUE}{SHADOW LIGHT_BLUE}{STR_VAR_1}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} at {STR_VAR_2}:{STR_VAR_3}.\n"
    "Wait for how long?"
}

script EventScript_QolMenu_Wait {
    lock

    qoltime()
    msgbox(EventScript_QolMenu_WaitText)

    switch(var(VAR_0x8000)){
        case TIME_MORNING:
            dynmultipush("Until day", 20)
            dynmultipush("Until evening", 30)
            dynmultipush("Until night", 40)
            dynmultistack(0, 0, FALSE, 9, FALSE, 20, DYN_MULTICHOICE_CB_NONE)
        case TIME_DAY:
            dynmultipush("Until evening", 30)
            dynmultipush("Until night", 40)
            dynmultipush("Until morning", 10)
            dynmultistack(0, 0, FALSE, 9, FALSE, 30, DYN_MULTICHOICE_CB_NONE)
        case TIME_EVENING:
            dynmultipush("Until night", 40)
            dynmultipush("Until morning", 10)
            dynmultipush("Until day", 20)
            dynmultistack(0, 0, FALSE, 9, FALSE, 40, DYN_MULTICHOICE_CB_NONE)
        case TIME_NIGHT:
            dynmultipush("Until morning", 10)
            dynmultipush("Until day", 20)
            dynmultipush("Until evening", 30)
            dynmultistack(0, 0, FALSE, 9, FALSE, 10, DYN_MULTICHOICE_CB_NONE)
        default:
            dynmultipush("Until morning", 10)
            dynmultipush("Until day", 20)
            dynmultipush("Until evening", 30)
            dynmultipush("Until night", 40)
            dynmultistack(0, 0, FALSE, 9, FALSE, 10, DYN_MULTICHOICE_CB_NONE)
    }

    switch(var(VAR_RESULT)){
        case 10:
            waittillmorning()
        case 20:
            waittillday()
        case 30:
            waittillevening()
        case 40:
            waittillnight()
        default:
    }
    waitmessage
    release
    return
}

script EventScript_QolMenu_PickAbiliChangeMon {
    lock
    getpartysize()
    switch(var(VAR_RESULT)){
        case 0:
            msgbox(format("You don't have any pokemon with you!"))
            waitmessage
            release
            return
        default:
            special(ChoosePartyMon)
            waitstate
            if(var(VAR_0x8004) >= PARTY_SIZE){
                msgbox(format("Another time then!"))
                waitmessage
                release
                return
            } else {
                call(EventScript_QolMenu_ShowAbilityMultichoice)
            }

    }

}

script EventScript_QolMenu_ShowAbilityMultichoice {
    
    getchosenmonabilities
    switch(var(VAR_RESULT)){
            case -1:
                msgbox(format("I can't change the ability of that!"))
                waitmessage
                release
                return
            case 0:
                msgbox(format("This pokemon can only have {STR_VAR_1}"))
                waitmessage
                release
                return
            case 5:
                msgbox(format("I can't work with that..."))
                waitmessage
                release
                return
            case 1:
                //  1 if first and second are available 
                msgbox(format("Which ability do you want?"))
                dynmultipush("{STR_VAR_1}", 0)
                dynmultipush("{STR_VAR_2}", 1)
                dynmultistack(0, 0, FALSE, 9, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            case 2:
                //  2 if first and hidden are available 
                msgbox(format("Which ability do you want?"))
                dynmultipush("{STR_VAR_1}", 0)
                dynmultipush("{STR_VAR_3}", 2)
                dynmultistack(0, 0, FALSE, 9, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            case 3:
                //  3 if second and hidden are available 
                msgbox(format("Which ability do you want?"))
                dynmultipush("{STR_VAR_2}", 1)
                dynmultipush("{STR_VAR_3}", 2)
                dynmultistack(0, 0, FALSE, 9, FALSE, 1, DYN_MULTICHOICE_CB_NONE)
            case 4:
                //  4 if all are available 
                msgbox(format("Which ability do you want?"))
                dynmultipush("{STR_VAR_1}", 0)
                dynmultipush("{STR_VAR_2}", 1)
                dynmultipush("{STR_VAR_3}", 2)
                dynmultistack(0, 0, FALSE, 9, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            default:
                msgbox(format("I can't work with that."))
                waitmessage
                release
                return
    }

    
    switch(var(VAR_RESULT)){
        case 0:
            msgbox(format("You picked the primary ability!"))
            setchosenmonfirstability
        case 1:
            msgbox(format("You picked the secondary ability!"))
            setchosenmonsecondability
        case 2:
            msgbox(format("You picked the hidden ability!"))
            setchosenmonhiddenability
        default:
            msgbox(format("What kind of choice is that?"))
    }
    waitmessage
    release
    return
}

script EventScript_QolMenu_PickNatureChangeMon {
    lock
    getpartysize()
    switch(var(VAR_RESULT)){
        case 0:
            msgbox(format("You don't have any pokemon with you!"))
            waitmessage
            release
            return
        default:
            special(ChoosePartyMon)
            waitstate
            if(var(VAR_0x8004) >= PARTY_SIZE){
                msgbox(format("Another time then!"))
                waitmessage
                release
                return
            } else {
                specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
                if(var(VAR_RESULT) == SPECIES_EGG){
                    msgbox(format("I can't change the nature of an egg!"))
                    waitmessage
                    release
                    return
                }
                bufferspeciesname(STR_VAR_1, VAR_RESULT)
                call(EventScript_QolMenu_ShowNatureMultichoice)
            }

    }

}


script EventScript_QolMenu_ShowNatureMultichoice {

    msgbox(format("Which hidden nature do you want for {STR_VAR_1}?"))
    dynmultipush("Hardy {CLEAR_TO 60} +Atk / -Atk", 0)
    dynmultipush("Lonely {CLEAR_TO 60} +Atk / -Def", 1)
    dynmultipush("Brave {CLEAR_TO 60} +Atk / -Spe", 2)
    dynmultipush("Adamant {CLEAR_TO 60} +Atk / -SpA", 3)
    dynmultipush("Naughty {CLEAR_TO 60} +Atk / -SpD", 4)
    dynmultipush("Bold {CLEAR_TO 60} +Def / -Atk", 5)
    dynmultipush("Docile {CLEAR_TO 60} +Def / -Def", 6)
    dynmultipush("Relaxed {CLEAR_TO 60} +Def / -Spe", 7)
    dynmultipush("Impish {CLEAR_TO 60} +Def / -SpA", 8)
    dynmultipush("Lax {CLEAR_TO 60} +Def / -SpD", 9)
    dynmultipush("Timid {CLEAR_TO 60} +Spe / -Atk", 10)
    dynmultipush("Hasty {CLEAR_TO 60} +Spe / -Def", 11)
    dynmultipush("Serious {CLEAR_TO 60} +Spe / -Spe", 12)
    dynmultipush("Jolly {CLEAR_TO 60} +Spe / -SpA", 13)
    dynmultipush("Naive {CLEAR_TO 60} +Spe / -SpD", 14)
    dynmultipush("Modest {CLEAR_TO 60} +SpA / -Atk", 15)
    dynmultipush("Mild {CLEAR_TO 60} +SpA / -Def", 16)
    dynmultipush("Quiet {CLEAR_TO 60} +SpA / -Spe", 17)
    dynmultipush("Bashful {CLEAR_TO 60} +SpA / -SpA", 18)
    dynmultipush("Rash {CLEAR_TO 60} +SpA / -SpD", 19)
    dynmultipush("Calm {CLEAR_TO 60} +SpD / -Atk", 20)
    dynmultipush("Gentle {CLEAR_TO 60} +SpD / -Def", 21)
    dynmultipush("Sassy {CLEAR_TO 60} +SpD / -Spe", 22)
    dynmultipush("Careful {CLEAR_TO 60} +SpD / -SpA", 23)
    dynmultipush("Quirky {CLEAR_TO 60} +SpD / -SpD", 24)
    dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if(var(VAR_RESULT) <= 24){
        special(SetHiddenNature)
    }

    waitmessage
    release
    return
}